    "Turn on notifications and we'll only ping you when your love sends something — a miss-you, an answer, a photo.": {
      "comment": "A description of the benefits of enabling notifications.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on notifications and we'll only ping you when your love sends something — a miss-you, an answer, a photo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications et nous vous enverrons un ping uniquement lorsque votre amour envoie quelque chose : une miss, une réponse, une photo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Benachrichtigungen und wir pingen Sie nur an, wenn Ihr Liebster etwas sendet – ein „Ich vermisse dich“, eine Antwort, ein Foto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 켜면 사랑하는 사람이 그리워하는 메시지, 답변, 사진 등을 보낼 때만 핑을 보내드립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as notificações e só enviaremos um ping quando seu amor enviar algo - uma saudade, uma resposta, uma foto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones y solo te enviaremos un ping cuando tu amor envíe algo: un mensaje de \"te extraño\", una respuesta, una foto."
          }
        }
      }
    },
