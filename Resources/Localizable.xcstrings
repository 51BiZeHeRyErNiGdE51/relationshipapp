    "Apple doesn't allow apps to add widgets for you — it only takes a few seconds by hand.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple doesn't allow apps to add widgets for you — it only takes a few seconds by hand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n'autorise pas les applications à ajouter des widgets à votre place : cela ne prend que quelques secondes à la main."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple erlaubt Apps nicht, Widgets für Sie hinzuzufügen – es dauert nur ein paar Sekunden von Hand."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple은 앱이 위젯을 추가하는 것을 허용하지 않습니다. 손으로 작업하는 데는 몇 초 밖에 걸리지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não permite que aplicativos adicionem widgets para você – isso leva apenas alguns segundos manualmente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no permite que las aplicaciones agreguen widgets por usted; solo toma unos segundos hacerlo manualmente."
          }
        }
      }
    },
