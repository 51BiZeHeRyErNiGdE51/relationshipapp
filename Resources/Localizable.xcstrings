    "Our Timeline" : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Notre chronologie" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Unsere Timeline" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "우리의 타임라인" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "A nossa cronologia" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Nuestra cronología" } }
      }
    },
    "The big milestones — first kiss, first trip, moving in. Your story in chapters." : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les grandes étapes — premier baiser, premier voyage, emménagement. Votre histoire en chapitres." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die großen Meilensteine — erster Kuss, erste Reise, Zusammenziehen. Eure Geschichte in Kapiteln." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "첫 키스, 첫 여행, 동거 시작 — 큰 순간들. 두 사람의 이야기를 챕터로." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Os grandes marcos — primeiro beijo, primeira viagem, viver juntos. A vossa história em capítulos." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Los grandes hitos — primer beso, primer viaje, mudanza juntos. Vuestra historia en capítulos." } }
      }
    },
    "Journal — the everyday moments" : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Journal — les moments du quotidien" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Tagebuch — die Alltagsmomente" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저널 — 일상의 순간들" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Diário — os momentos do dia a dia" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Diario — los momentos del día a día" } }
      }
    },
    "Your shared journal" : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Votre journal partagé" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Euer gemeinsames Tagebuch" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "둘만의 공유 저널" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "O vosso diário partilhado" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Vuestro diario compartido" } }
      }
    },
    "Memories is your everyday journal — the small stuff: a funny dinner, a rainy walk, a photo you don't want to lose. The Timeline above is for the big milestones only." : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Souvenirs est votre journal du quotidien — les petites choses : un dîner drôle, une balade sous la pluie, une photo à garder. La chronologie au-dessus est réservée aux grandes étapes." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerungen ist euer Alltagstagebuch — die kleinen Dinge: ein lustiges Abendessen, ein Spaziergang im Regen, ein Foto zum Behalten. Die Timeline darüber ist nur für die großen Meilensteine." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "추억은 일상의 저널이에요 — 재미있던 저녁, 비 오는 날 산책, 간직하고 싶은 사진 같은 소소한 것들. 위의 타임라인은 큰 순간들만을 위한 공간이에요." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Memórias é o vosso diário do dia a dia — as pequenas coisas: um jantar divertido, um passeio à chuva, uma foto a guardar. A cronologia acima é só para os grandes marcos." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Recuerdos es vuestro diario del día a día — las pequeñas cosas: una cena divertida, un paseo bajo la lluvia, una foto que no quieres perder. La cronología de arriba es solo para los grandes hitos." } }
      }
    },
    "Tap + to write your first memory. Both of you see everything here." : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Touche + pour écrire votre premier souvenir. Vous voyez tout ici, tous les deux." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Tippe auf +, um eure erste Erinnerung zu schreiben. Ihr seht hier beide alles." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "+를 눌러 첫 추억을 기록해 보세요. 여기 있는 모든 것은 둘 다 볼 수 있어요." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Toca em + para escrever a vossa primeira memória. Aqui, veem tudo os dois." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Toca + para escribir vuestro primer recuerdo. Aquí lo veis todo los dos." } }
      }
    },
    "New Memory" : {
