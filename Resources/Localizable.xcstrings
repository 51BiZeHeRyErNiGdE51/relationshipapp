    "The emoji becomes the marker on your timeline — 💋 first kiss, ✈️ first trip, 💍 proposal, 🏠 moved in…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The emoji becomes the marker on your timeline — 💋 first kiss, ✈️ first trip, 💍 proposal, 🏠 moved in…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
