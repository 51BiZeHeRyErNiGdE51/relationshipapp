    },
    "We couldn't connect. Check your internet and try again." : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connexion impossible. Vérifie ta connexion internet et réessaie." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine Verbindung möglich. Prüfe dein Internet und versuch es erneut." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결할 수 없어요. 인터넷 연결을 확인하고 다시 시도해 주세요." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível ligar. Verifica a tua internet e tenta de novo." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No pudimos conectar. Comprueba tu internet e inténtalo de nuevo." } }
      }
    },
    "Try Again" : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réessayer" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erneut versuchen" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 시도" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Tentar de novo" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Reintentar" } }
      }
    },
    "Something went wrong" : {
      "localizations" : {
