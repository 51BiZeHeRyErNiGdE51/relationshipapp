    "Powers your day counter, the anniversary countdown on Home and the Love Days widget. Change it any time in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Powers your day counter, the anniversary countdown on Home and the Love Days widget. Change it any time in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimente votre compteur journalier, le compte à rebours d'anniversaire sur Home et le widget Love Days. Modifiez-le à tout moment dans Paramètres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versorgt Ihren Tageszähler, den Jubiläums-Countdown auf der Startseite und das Love Days-Widget. Sie können es jederzeit in den Einstellungen ändern."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 카운터, 홈의 기념일 카운트다운 및 Love Days 위젯을 강화합니다. 언제든지 설정에서 변경하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimenta o contador diário, a contagem regressiva de aniversário na página inicial e o widget Love Days. Altere-o a qualquer momento nas Configurações."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa tu contador de días, la cuenta regresiva de aniversario en Inicio y el widget Días del amor. Cámbielo en cualquier momento en Configuración."
          }
        }
      }
    },
    "Questions, bugs, ideas — we read everything.": {
      "localizations": {
