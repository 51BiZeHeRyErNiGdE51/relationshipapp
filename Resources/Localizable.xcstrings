            "state": "translated",
            "value": "El entrenador de IA utiliza esto para comprender dónde hacen clic y dónde empujar."
          }
        }
      }
    },
    "The big milestones — first kiss, first trip, moving in. Your story in chapters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die großen Meilensteine — erster Kuss, erste Reise, Zusammenziehen. Eure Geschichte in Kapiteln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los grandes hitos — primer beso, primer viaje, mudanza juntos. Vuestra historia en capítulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les grandes étapes — premier baiser, premier voyage, emménagement. Votre histoire en chapitres."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 키스, 첫 여행, 동거 시작 — 큰 순간들. 두 사람의 이야기를 챕터로."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os grandes marcos — primeiro beijo, primeira viagem, viver juntos. A vossa história em capítulos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The big milestones — first kiss, first trip, moving in. Your story in chapters."
          }
        }
      }
    },
    "The day before and the morning of your countdowns, birthdays and anniversaries.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day before and the morning of your countdowns, birthdays and anniversaries."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La veille et le matin de vos comptes à rebours, anniversaires et anniversaires."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vortag und der Morgen Ihrer Countdowns, Geburtstage und Jubiläen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
