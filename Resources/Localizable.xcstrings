        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca em + para escrever a vossa primeira memória. Aqui, veem tudo os dois."
          }
        }
      }
    },
    "Tap Love, Hug or Miss you and it lands as a push on their phone — even when the app is closed. Little signals that say you're thinking of them right now." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf Liebe, Umarmung oder Vermissen — und es kommt als Push auf ihrem Handy an, auch wenn die App zu ist. Kleine Zeichen, dass du gerade an sie denkst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Love, Hug or Miss you and it lands as a push on their phone — even when the app is closed. Little signals that say you're thinking of them right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Amor, Abrazo o Te echo de menos y llega como aviso a su teléfono — aunque la app esté cerrada. Pequeñas señales de que estás pensando en ellos ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche Amour, Câlin ou Tu me manques : ça arrive en notification sur leur téléphone — même si l'app est fermée. De petits signes qui disent que tu penses à eux maintenant."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사랑·안아줘·보고 싶어를 누르면 앱이 꺼져 있어도 상대 폰에 푸시로 도착해요. 지금 생각 중이라는 작은 신호예요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca em Amor, Abraço ou Sinto a tua falta e chega como notificação no telemóvel deles — mesmo com a app fechada. Pequenos sinais de que estás a pensar neles agora."
          }
        }
      }
    },
