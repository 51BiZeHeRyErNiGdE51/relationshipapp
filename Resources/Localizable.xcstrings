    "Your journal, answers and moods are visible only to the two of you. iCloud backup keeps private notes on your device account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your journal, answers and moods are visible only to the two of you. iCloud backup keeps private notes on your device account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre journal, vos réponses et vos humeurs ne sont visibles que par vous deux. La sauvegarde iCloud conserve les notes privées sur le compte de votre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Tagebuch, Ihre Antworten und Stimmungen sind nur für Sie beide sichtbar. Durch das iCloud-Backup werden private Notizen auf Ihrem Gerätekonto gespeichert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 일기, 답변 및 기분은 귀하와 두 사람에게만 표시됩니다. iCloud 백업은 기기 계정에 비공개 메모를 보관합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu diário, respostas e humor são visíveis apenas para vocês dois. O backup do iCloud mantém notas privadas na conta do seu dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su diario, sus respuestas y sus estados de ánimo son visibles solo para ustedes dos. La copia de seguridad de iCloud mantiene notas privadas en la cuenta de su dispositivo."
          }
        }
      }
    },
