    "You'll get a fresh invite code and can pair again anytime. If you purchased Premium, it stays with you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll get a fresh invite code and can pair again anytime. If you purchased Premium, it stays with you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevrez un nouveau code d'invitation et pourrez vous associer à nouveau à tout moment. Si vous avez acheté Premium, il reste avec vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie erhalten einen neuen Einladungscode und können die Verbindung jederzeit erneut herstellen. Wenn Sie Premium gekauft haben, bleibt es bei Ihnen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 초대 코드를 받게 되며 언제든지 다시 페어링할 수 있습니다. Premium을 구매한 경우 Premium은 그대로 유지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você receberá um novo código de convite e poderá emparelhar novamente a qualquer momento. Se você comprou o Premium, ele permanece com você."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás un código de invitación nuevo y podrás volver a emparejarte en cualquier momento. Si compraste Premium, permanece contigo."
          }
        }
      }
    },
