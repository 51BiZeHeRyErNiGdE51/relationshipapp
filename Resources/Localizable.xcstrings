    "Every answered question, mood check-in, memory and streak day feeds it. Reach 100% growth to evolve to the next stage.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every answered question, mood check-in, memory and streak day feeds it. Reach 100% growth to evolve to the next stage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque question répondue, chaque enregistrement d'humeur, chaque mémoire et chaque journée de séquence le nourrissent. Atteignez 100% de croissance pour évoluer vers l'étape suivante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede beantwortete Frage, jeder Stimmungscheck, jede Erinnerung und jeder Streak-Tag nährt es. Erreichen Sie 100 % Wachstum, um zur nächsten Stufe zu gelangen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 답변된 질문, 기분 확인, 추억, 연속 기록이 이를 뒷받침합니다. 성장 100%를 달성하여 다음 단계로 진화하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pergunta respondida, verificação de humor, memória e dia consecutivo alimentam isso. Alcance 100% de crescimento para evoluir para o próximo estágio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pregunta respondida, control del estado de ánimo, memoria y racha diaria lo alimentan. Alcanza el 100% de crecimiento para evolucionar a la siguiente etapa."
          }
        }
      }
    },
    "Everything you send each other — notes, photos, miss-yous, moods — shows up here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you send each other — notes, photos, miss-yous, moods — shows up here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous vous envoyez – notes, photos, miss, humeurs – apparaît ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was Sie einander schicken – Notizen, Fotos, Miss-Yous, Stimmungen – wird hier angezeigt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모, 사진, 그리운 소식, 기분 등 서로에게 보내는 모든 내용이 여기에 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que vocês enviam – notas, fotos, saudades, humores – aparece aqui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que se envían (notas, fotos, extrañamientos, estados de ánimo) aparece aquí."
          }
        }
      }
    },
